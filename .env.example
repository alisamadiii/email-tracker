# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5433/business_tracker

# Random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public URL the app is served from
BETTER_AUTH_URL=http://localhost:3000

# Secret for manually triggering /api/cron/* jobs
CRON_SECRET=dev-cron-secret
